{
  "chrono": [
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:chrono/remove-old-time-feature.patch"
      ],
      "version": "*"
    }
  ],
  "drm-fourcc": [
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:drm-fourcc-2.2.0/add_license.patch"
      ],
      "version": "2.2.0"
    }
  ],
  "hmac-sha256": [
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:hmac-sha256-0.1.7/add-license.patch"
      ],
      "version": "0.1.7"
    }
  ],
  "rand": [
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:rand-0.7.3/remove-log-from-reseed.patch"
      ],
      "version": "0.7.3"
    },
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:rand-0.8.5/remove-log-from-reseed.patch"
      ],
      "version": "0.8.5"
    }
  ],
  "regex-syntax": [
    {
      "crate_features": [
        "unicode"
      ]
    }
  ],
  "riscv-rt-macros": [
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:riscv-rt-macros/riscv-rt-macros-0.1.6-update-dependencies.patch"
      ],
      "version": "*"
    }
  ],
  "rtt-target": [
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:rtt-target/add-license.patch"
      ],
      "version": "*"
    }
  ],
  "rustix": [
    {
      "additive_build_file_content": "load(\"@@//bazel/module_extensions/private:symlink.bzl\", \"symlink_without_target\")\n\nconfig_setting(\n  name = \"is_release\",\n  values = {\"compilation_mode\": \"opt\"}\n)\n\nsymlink_without_target(\n    name = \"static_libs\",\n    actual = select({\n        \":is_release\": \"src/backend/linux_raw/arch/outline/release\",\n        \"//conditions:default\": \"src/backend/linux_raw/arch/outline/debug\",\n    }),\n    out = \"static_libs\",\n)\n",
      "data": [
        ":static_libs"
      ],
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:rustix/disable-features.patch"
      ],
      "rustc_flags": [
        "-L$(location :static_libs)"
      ]
    },
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:rustix-1.0.8/0001-build-Use-temporary-file-for-can_compile.patch"
      ],
      "version": "1.0.8"
    }
  ],
  "serde_json": [
    {
      "crate_features": [
        "alloc"
      ]
    }
  ],
  "void": [
    {
      "patch_args": [
        "-p1"
      ],
      "patch_tool": "patch",
      "patches": [
        "@@//third_party/rust_crates/patches:void/relicense-to-dual-mit-apache.patch"
      ],
      "version": "*"
    }
  ]
}
